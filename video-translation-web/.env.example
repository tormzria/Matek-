# Copy to .env for local dev (docker/uvicorn read the environment).
# You need three capabilities: speech-to-text, translation, text-to-speech.

# --- Speech-to-text (OpenAI-compatible /audio/transcriptions) ---
# OpenAI: base https://api.openai.com/v1  model whisper-1
# Groq:   base https://api.groq.com/openai/v1  model whisper-large-v3
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_API_KEY=

# --- Translation LLM ---
# If ANTHROPIC_API_KEY is set, translation uses Claude (claude-opus-4-8) by default.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# To use an OpenAI-compatible chat model instead, set LLM_PROVIDER=openai:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# One OPENAI_API_KEY can back both STT and OpenAI translation:
# OPENAI_API_KEY=

TARGET_LANGUAGE=Hungarian

# --- Text-to-speech (ElevenLabs) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George" preset
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Service ---
# MAX_UPLOAD_MB=300
# WORKER_COUNT=1
# JOB_RETENTION_HOURS=6
